# Railway backend variables
# Set these in Railway service Variables, not in GitHub.

PORT=4000

# Railway PostgreSQL gives PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD.
# Use the private Railway host/port for backend service.
SPRING_DATASOURCE_URL=jdbc:postgresql://${PGHOST}:${PGPORT}/${PGDATABASE}
SPRING_DATASOURCE_USERNAME=${PGUSER}
SPRING_DATASOURCE_PASSWORD=${PGPASSWORD}

# Allow the Vercel preview/production frontend to call backend.
# Replace van-moc.vercel.app with your actual Vercel URL after first deploy.
APP_CORS_ALLOWED_ORIGINS=https://*.vercel.app,https://van-moc.vercel.app,http://localhost:3000

# Optional Google OAuth client.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
